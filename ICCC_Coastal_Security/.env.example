# Copy to .env and change every value before any non-demo use.
POSTGRES_PASSWORD=iccc_poc_change_me
# JWT signing secret — generate with:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=POC-ONLY-CHANGE-ME-this-key-is-not-secret
# Shared password of the synthetic demo accounts (seeded on first start only)
DEMO_PASSWORD=Demo@2026
APP_PORT=8000
SIM_ENABLED=true
SIM_TIME_FACTOR=20
SESSION_IDLE_MINUTES=30
# Point these at an internal tile server / authorised chart service for offline or production use
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
SEAMARK_TILE_URL=https://tiles.openseamap.org/seamark/{z}/{x}/{y}.png
# Optional registry mirrors for base images (useful when Docker Hub rate-limits)
# PYTHON_IMAGE=mirror.gcr.io/library/python:3.11-slim
# NODE_IMAGE=mirror.gcr.io/library/node:22-alpine
