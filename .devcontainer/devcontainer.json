{
  "name": "Coastal Analytics Demo (Python 3.13)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm@sha256:0aa711e570b306c02946cdda67587ce8c65978dbb65691341cbcfd4854dfcfff",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "dashboard/app.py"
      ]
    },
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "postCreateCommand": "python -m venv .venv && .venv/bin/python -m pip install --require-hashes -r requirements.txt",
  "postAttachCommand": {
    "server": ".venv/bin/python -m streamlit run dashboard/app.py --server.enableCORS=true --server.enableXsrfProtection=true"
  },
  "portsAttributes": {
    "8501": {
      "label": "Synthetic research demo",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}
